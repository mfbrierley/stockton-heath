{
  "expo": {
    "name": "Stockton Heath",
    "slug": "stockton-heath",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/sh-icon.png",
    "scheme": "stocktonheath",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mattbrierley1.stocktonheath",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Stockton Heath doesn't use your location. iOS asks for this text because the map in the app could show where you are, but the app never turns that on."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sh-icon.png",
        "backgroundColor": "#1B4332"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mattbrierley1.stocktonheath",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/sh-icon.png",
          "color": "#ffffff",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B4332",
          "dark": {
            "backgroundColor": "#1B4332"
          },
          "android": {
            "image": "./assets/images/sh-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "react-native-fbsdk-next",
        {
          "appID": "1710831803797789",
          "clientToken": "2cf14af90449a5caf540eac95f49f202",
          "displayName": "Stockton Heath",
          "isAutoInitEnabled": true,
          "autoLogAppEventsEnabled": true,
          "advertiserIDCollectionEnabled": false,
          "iosUserTrackingPermission": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets Stockton Heath see how people find the app. Nothing in the app changes if you say no."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99721d3f-5cda-481a-bf9d-f4a170ea4c95"
      }
    },
    "owner": "mattbrierley1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/99721d3f-5cda-481a-bf9d-f4a170ea4c95"
    }
  }
}
